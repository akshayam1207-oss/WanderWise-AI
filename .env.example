# WanderWise AI Environment Configuration Template
# Copy this file to .env and configure your values

# Django Settings
SECRET_KEY=your-production-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com

# Google Gemini API Key (for Generative AI Assistant responses)
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection (for Chat logs and user feedback storage)
# Example for local MongoDB: mongodb://localhost:27017/
# Example for MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=wanderwise_db
